# Copy to .env and fill in. .env is gitignored.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# Port for the local Flask server (default 8001)
PORT=8001

# Must exactly match the redirect URI registered in the Meta portal.
# Instagram requires HTTPS. Use an https tunnel (ngrok / cloudflared).
INSTAGRAM_REDIRECT_URI=https://localhost:8001/callback

# Flask session signing key (any random string)
FLASK_SECRET=change_me
