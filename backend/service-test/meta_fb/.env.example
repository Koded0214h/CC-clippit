# Copy to .env and fill in. .env is gitignored.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Port for the local Flask server (default 8002)
PORT=8002

# Must exactly match the redirect URI registered in the Meta portal.
# Use an https tunnel (ngrok / cloudflared) for local dev.
FACEBOOK_REDIRECT_URI=https://localhost:8002/callback

# Flask session signing key (any random string)
FLASK_SECRET=change_me
