# Copy to .env and fill in. .env is gitignored.

# Required — sign up at https://twitterapi.io (free trial credits)
TWITTERAPI_IO_KEY=your_twitterapi_io_key

# Optional — official X OAuth 2.0 for real account binding
# Create an app at https://developer.x.com/ → User authentication → OAuth 2.0
# App type: Web App, OAuth 2.0, scopes: tweet.read users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# Port for the local Flask server (default 8004)
PORT=8004

# Must exactly match a Callback URI registered in the X developer portal.
# X allows http://127.0.0.1 for local dev.
X_REDIRECT_URI=http://127.0.0.1:8004/callback

# Flask session signing key (any random string)
FLASK_SECRET=change_me
