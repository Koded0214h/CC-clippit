# Copy to .env and fill in. .env is gitignored.
TIKTOK_CLIENT_KEY=your_sandbox_client_key
TIKTOK_CLIENT_SECRET=your_sandbox_client_secret

# Port for the local Flask server (default 8000)
PORT=8000

# Must exactly match the Redirect URI registered in the TikTok portal.
# TikTok rejects http://localhost for some apps; use an https tunnel URL then.
TIKTOK_REDIRECT_URI=http://localhost:8000/callback

# Flask session signing key (any random string)
FLASK_SECRET=change_me
