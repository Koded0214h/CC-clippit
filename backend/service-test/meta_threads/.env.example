# Copy to .env and fill in. .env is gitignored.
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret

# Port for the local Flask server (default 8003)
PORT=8003

# Must exactly match the redirect URI registered in the Meta portal.
# Threads requires HTTPS. Use an https tunnel (ngrok / cloudflared).
THREADS_REDIRECT_URI=https://localhost:8003/callback

# Flask session signing key (any random string)
FLASK_SECRET=change_me
