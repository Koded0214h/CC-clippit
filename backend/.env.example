# Copy to .env and fill in. .env is gitignored.

# --- Core ---
# asyncpg URL. Compose publishes Postgres on host **5433** so it does not
# collide with a Homebrew server on 5432.
DATABASE_URL=postgresql+asyncpg://clippit:clippit@localhost:5433/clippit
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440
PORT=8000

# Shared secret checked on /internal/* routes (X-Internal-Secret header).
# Kept even inside one monolith so the boundary stays honest if a module
# ever gets split into its own service later.
INTERNAL_SERVICE_SECRET=change_me_shared_secret

# Origin(s) allowed to call this API from the browser (comma-separated).
# The Next.js app in frontend/ runs on 5174.
FRONTEND_ORIGIN=http://localhost:5174

# In-memory by default — fine for one process. Point this at Redis
# (redis://host:6379) once this runs as more than one worker/instance,
# or /auth/login and /auth/signup rate limits become N times too generous.
RATE_LIMIT_STORAGE_URI=memory://

# --- TikTok (Login Kit + Display API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/social/tiktok/callback

# --- Facebook Login ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/social/facebook/callback

# --- Instagram (Business Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/social/instagram/callback

# --- Threads ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/social/threads/callback

# --- X (OAuth for identity, twitterapi.io for metrics) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/social/x/callback
TWITTERAPI_IO_KEY=
