# Copy to .env and fill in. .env is gitignored.

# --- Core ---
# asyncpg URL. Compose publishes Postgres on host **5433** so it does not
# collide with a Homebrew server on 5432.
DATABASE_URL=postgresql+asyncpg://clippit:clippit@localhost:5433/clippit
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=1440
PORT=8000

# Shared secret checked on /internal/* routes (X-Internal-Secret header).
# Kept even inside one monolith so the boundary stays honest if a module
# ever gets split into its own service later.
INTERNAL_SERVICE_SECRET=change_me_shared_secret

# Origin(s) allowed to call this API from the browser (comma-separated).
# The Next.js app in frontend/ runs on 5174.
FRONTEND_ORIGIN=http://localhost:5174

# In-memory by default — fine for one process. Point this at Redis
# (redis://host:6379) once this runs as more than one worker/instance,
# or /auth/login and /auth/signup rate limits become N times too generous.
RATE_LIMIT_STORAGE_URI=memory://

# --- TikTok (Login Kit + Display API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/social/tiktok/callback

# --- Facebook Login ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/social/facebook/callback

# --- Instagram (Business Login) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/social/instagram/callback

# --- Threads ---
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/social/threads/callback

# --- X (OAuth for identity, twitterapi.io for metrics) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/social/x/callback
TWITTERAPI_IO_KEY=

# --- Environment -----------------------------------------------------------
# `production` makes the app refuse to start with the sandbox payment
# provider, default secrets, or the console mailer (core/startup.py).
ENVIRONMENT=development
# Password hashing cost. 12 for production; tests lower it.
BCRYPT_ROUNDS=12

# --- Email / one-time codes ------------------------------------------------
# `console` prints the message (the verification code) to the server output.
EMAIL_BACKEND=console
EMAIL_FROM=Clippit <no-reply@clippit.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Uploads ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/uploads
# Used to build the URLs returned for uploaded files.
PUBLIC_BASE_URL=http://localhost:8000

# --- Money -----------------------------------------------------------------
# `sandbox` never touches a network and never moves real money. There is no
# other provider yet (decision D23).
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
FUNDING_FEE_RATE=0.015
EARNINGS_HOLD_DAYS=5
MIN_WITHDRAWAL=1000

# Run settlement / sweeps / payout reconciliation inside the API process.
BACKGROUND_JOBS_ENABLED=false
